.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.streamlit/secrets.toml

# Source extracts — confidential (supplier pricing, BOMs, build plans).
# Never commit these — EXCEPT data/cloud/* for Streamlit Cloud deployment.
# Ignore data/ FIRST, then un-ignore specific files (order matters!)
data/

# Un-ignore data/cloud/ for synced Google Sheets
!data/cloud/
!data/cloud/*.csv

# Un-ignore hand-maintained files
!data/build_plan.csv
!data/plan_to_date.csv
!data/in_transit.csv
!data/exclusions.csv
!data/golden_cases.csv
.streamlit/secrets.toml

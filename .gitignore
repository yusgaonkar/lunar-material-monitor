# Source extracts — confidential (supplier pricing, BOMs, build plans).
# Never commit these — EXCEPT data/cloud/* for Streamlit Cloud deployment.

# Ignore ALL data/ EXCEPT explicitly committed files below
/data/
# Whitelist: files we DO want to commit
!/data/cloud/
!/data/build_plan.csv
!/data/plan_to_date.csv
!/data/in_transit.csv
!/data/exclusions.csv
!/data/golden_cases.csv
# Within cloud/ allow all CSV files
!/data/cloud/
/data/cloud/*
!/data/cloud/*.csv
.streamlit/secrets.toml
